# ============================================
# OSdex - Backend Environment Variables
# ============================================
# Copy this file and use the appropriate one:
#   - Desenvolvimento: .env.development (versionado)
#   - Produção: .env.production (NÃO versionado - criar manualmente)
#   - Override local: .env (gitignorado)
# ============================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ordex_db"

# JWT
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Frontend URL (usado para CORS em produção — aceita vários, separados por vírgula)
FRONTEND_URL="http://localhost:3000"

# Emails autorizados a criar restaurantes via onboarding (separados por vírgula)
ONBOARDING_ADMIN_EMAILS="fluixit@gmail.com"

# Seed do admin do sistema (obrigatórios em produção)
# SEED_ADMIN_PASSWORD="definir-antes-de-rodar-o-seed"
# SEED_ADMIN_PIN="1234"
