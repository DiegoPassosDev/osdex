# ============================================
# OSdex - Frontend Environment Variables
# ============================================
# Copy this file and use the appropriate one:
#   - Desenvolvimento: .env.development (versionado)
#   - Produção: definido no Vercel Dashboard
#   - Override local: .env.local (gitignorado)
# ============================================

# URL da aplicação frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email de suporte
NEXT_PUBLIC_SUPPORT_EMAIL=fluixit@gmail.com

# ⚠️ Em desenvolvimento local, NÃO defina NEXT_PUBLIC_API_URL nem NEXT_PUBLIC_WS_URL.
#   O Next.js faz proxy via rewrites (next.config.ts).
#   Defina apenas se precisar de URLs customizadas (ex: rede local).
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_WS_URL=http://localhost:3001
